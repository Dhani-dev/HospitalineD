PORT=3000
NODE_ENV=production
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_prod_key_here
SUPABASE_SECRET_KEY=sb_secret_prod_key_here
SUPABASE_JWKS_URL=https://your-prod-project.supabase.co/auth/v1/.well-known/jwks.json
RENDER_PROD_DEPLOY_HOOK=https://api.render.com/deploy/srv-prod-hook
USERS_API_URL=http://48.217.130.84
USERS_LAST_PATH=/api/v2/users/last
USERS_LIST_PATH=/api/users
ENTRENADOR_API_URL=https://pokenetes-api-prod.onrender.com
ENTRENADOR_LAST_PATH=/api/v2/entrenador/last
ENTRENADOR_LIST_PATH=/entrenador
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_TTL_SECONDS=60
PEER_CACHE_TTL_SECONDS=30
# Hueco: el orquestador de Pokenetes llama a Hospitaline, no al revés.
ORCHESTRATOR_API_URL=
# Grafana Cloud > stack del equipo > OpenTelemetry > OTLP endpoint. El header es secreto.
OTEL_SERVICE_NAME=hospitaline-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
