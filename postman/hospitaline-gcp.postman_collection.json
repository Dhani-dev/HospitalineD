{
  "info": {
    "name": "Hospitaline GCP (Cloud Run)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://REEMPLAZAR-CON-terraform-output-api_url.run.app" },
    { "key": "hospitalId", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "pacienteId", "value": "" }
  ],
  "item": [
    { "name": "Health (Redis + telemetría)", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    {
      "name": "Crear hospital",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('hospitalId', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/hospitals",
        "body": { "mode": "raw", "raw": "{\"name\":\"Hospital Central\",\"address\":\"Calle 10\",\"city\":\"Medellín\",\"phone\":\"6041234567\"}" }
      }
    },
    {
      "name": "Crear doctor",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('doctorId', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/doctors",
        "body": { "mode": "raw", "raw": "{\"hospital_id\":\"{{hospitalId}}\",\"first_name\":\"Ana\",\"last_name\":\"Gómez\",\"specialty\":\"Cardiología\",\"email\":\"ana{{$timestamp}}@hospitaline.co\"}" }
      }
    },
    {
      "name": "Crear paciente",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('pacienteId', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/pacientes",
        "body": { "mode": "raw", "raw": "{\"hospital_id\":\"{{hospitalId}}\",\"doctor_id\":\"{{doctorId}}\",\"first_name\":\"Luis\",\"last_name\":\"Pérez\",\"birth_date\":\"1990-05-20\",\"condition\":\"Control\",\"status\":\"stable\"}" }
      }
    },
    { "name": "Listar hospitales", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/hospitals" } },
    { "name": "Hospital por id", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/hospitals/{{hospitalId}}" } },
    {
      "name": "Actualizar ciudad del hospital",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/hospitals/{{hospitalId}}",
        "body": { "mode": "raw", "raw": "{\"city\":\"Cali\"}" }
      }
    },
    { "name": "Listar doctores", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/doctors" } },
    { "name": "Listar pacientes", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/pacientes" } },
    { "name": "v2 último hospital", "request": { "method": "GET", "url": "{{baseUrl}}/api/v2/hospitals/last" } },
    { "name": "v2 hospital + peers", "request": { "method": "GET", "url": "{{baseUrl}}/api/v2/hospitals/{{hospitalId}}" } },
    { "name": "v2 paciente + peers", "request": { "method": "GET", "url": "{{baseUrl}}/api/v2/pacientes/{{pacienteId}}" } },
    { "name": "Eliminar hospital (cascada)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/hospitals/{{hospitalId}}" } }
  ]
}
