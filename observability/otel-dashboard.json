{
  "uid": "hospitaline-otel",
  "title": "Hospitaline OpenTelemetry",
  "tags": ["hospitaline", "opentelemetry", "seguimiento-2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "text",
      "title": "Paso 2: OpenTelemetry",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "RED de la API. Trazas: Explore → Tempo, servicio `hospitaline-api`, spans `peer.biblio-express` y `peer.pokenetes`. El orquestador aún no está conectado. Primero usa el dashboard GCP Metrics."
      }
    },
    {
      "type": "timeseries",
      "title": "Peticiones por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "expr": "sum by (http_route, http_method) (rate(http_server_requests_total{service_name=\"hospitaline-api\"}[5m]))",
          "legendFormat": "{{http_method}} {{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errores por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "expr": "sum by (http_route, http_status_code) (rate(http_server_errors_total{service_name=\"hospitaline-api\"}[5m]))",
          "legendFormat": "{{http_route}} {{http_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia p95 (ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_milliseconds_bucket{service_name=\"hospitaline-api\"}[5m])))",
          "legendFormat": "p95 {{http_route}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      }
    ]
  }
}
