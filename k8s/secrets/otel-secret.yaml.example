# Crear el secreto en GKE cuando tengas el header de Grafana Cloud.
# No subas el valor real a git.
#
#   kubectl create secret generic hospitaline-otel \
#     -n hospitaline-prod \
#     --from-literal=OTEL_EXPORTER_OTLP_ENDPOINT='https://otlp-gateway-prod-us-east-3.grafana.net/otlp' \
#     --from-literal=OTEL_EXPORTER_OTLP_HEADERS='Authorization=Basic PEGA_AQUI'
#
apiVersion: v1
kind: Secret
metadata:
  name: hospitaline-otel
  namespace: hospitaline-prod
type: Opaque
stringData:
  OTEL_EXPORTER_OTLP_ENDPOINT: "https://otlp-gateway-prod-us-east-3.grafana.net/otlp"
  OTEL_EXPORTER_OTLP_HEADERS: "Authorization=Basic REPLACE_ME"
